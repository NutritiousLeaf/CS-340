# --- Imports ---
from jupyter_dash import JupyterDash
from dash import dcc, html
from dash import dash_table
from dash.dependencies import Input, Output
import pandas as pd
import base64, os

# Codio/Jupyter proxy
JupyterDash.infer_jupyter_proxy_config()

# --- Logo helper ---
# Use the PNG that sits next to your notebook
LOGO_PATH = "Grazioso Salvare Logo.png"

def img_tag_from_file(path, height_px=60):
    if not os.path.exists(path):
        return html.Div("Logo not found", style={"color":"red"})
    encoded = base64.b64encode(open(path, "rb").read()).decode()
    src = f"data:image/png;base64,{encoded}"
    return html.A(
        html.Img(src=src, style={"height": f"{height_px}px"}),
        href="https://www.snhu.edu",
        target="_blank"
    )
# --- CRUD module connect + load base dataframe ---

from CRUD_Python_Module import AnimalShelter 

aac = AnimalShelter(username="aacuser", password="password")

# Pull ALL documents once for the initial (reset) table
try:
    raw = list(aac.read({}))   
except TypeError:
    raw = list(aac.read())     

df = pd.DataFrame(raw)
if "_id" in df.columns:
    df = df.drop(columns=["_id"])

# --- Rescue filters UI ---
filter_control = html.Div([
    html.Label("Rescue Filter:", style={"fontWeight": 600, "marginRight": "10px"}),
    dcc.RadioItems(
        id="rescue-filter",
        options=[
            {"label": "Reset (All)",          "value": "reset"},
            {"label": "Water Rescue",         "value": "water"},
            {"label": "Mountain/Wilderness",  "value": "mountain"},
            {"label": "Disaster/Tracking",    "value": "disaster"},
        ],
        value="reset",
        inline=True
    ),
    html.Div(id="result-count", style={"marginTop": "6px", "fontStyle": "italic"})
], style={"margin":"8px 0 14px 0"})

# --- Query builder (breeds/sex/age windows per spec) ---
def build_query(kind: str) -> dict:
    if kind == "water":
        breeds = ["Labrador Retriever", "Chesapeake Bay Retriever", "Newfoundland"]
        sex = "Intact Female";  min_w, max_w = 26, 156
    elif kind == "mountain":
        breeds = ["German Shepherd","Alaskan Malamute","Old English Sheepdog",
                  "Siberian Husky","Rottweiler"]
        sex = "Intact Male";    min_w, max_w = 26, 156
    elif kind == "disaster":
        breeds = ["Doberman Pinscher","German Shepherd","Golden Retriever",
                  "Bloodhound","Rottweiler"]
        sex = "Intact Male";    min_w, max_w = 20, 300
    else:
        return {}

    breed_or = [{"breed": {"$regex": b, "$options": "i"}} for b in breeds]

    return {
        "$and": [
            {"animal_type": "Dog"},
            {"sex_upon_outcome": {"$regex": f"^{sex}$", "$options": "i"}},
            {"age_upon_outcome_in_weeks": {"$gte": min_w, "$lte": max_w}},
            {"$or": breed_or},
        ]
    }
# --- LAYOUT + 2 CALLBACKS + RUN (Map + Pie wired to the same filter) ---

import dash_leaflet as dl
import plotly.express as px
from jupyter_dash import JupyterDash

app = JupyterDash(__name__, suppress_callback_exceptions=True)

# Map shell
map_component = html.Div([
    html.Hr(),
    html.H4("Geolocation Map"),
    dl.Map(center=[30.27, -97.74], zoom=9, style={"height": "420px", "width": "100%"},
           children=[dl.TileLayer(), dl.MarkerClusterGroup(id="map-cluster")])
], style={"marginTop": "16px"})

# Pie shell
pie_component = html.Div([
    html.Hr(),
    html.H4("Breed Distribution (Top 10)"),
    dcc.Graph(id="breed-pie", config={"displayModeBar": False})
], style={"marginTop": "16px"})

app.layout = html.Div([
    html.Div([
        img_tag_from_file(LOGO_PATH, height_px=50),
        html.Div("Grazioso Salvare — Dashboard • Kyle Marinaro",
                 style={"fontSize":"22px","fontWeight":"600","marginLeft":"12px"})
    ], style={"display":"flex","alignItems":"center","gap":"12px","marginBottom":"10px"}),

    filter_control,   

    dash_table.DataTable(
        id="aac-table",
        data=df.to_dict("records"),
        columns=[{"name": c.replace("_"," ").title(), "id": c} for c in df.columns],
        page_size=10,
        sort_action="native",
        filter_action="none",
        style_table={"overflowX":"auto","maxHeight":"48vh","overflowY":"auto"},
        style_cell={"fontFamily":"Arial","fontSize":"14px","textAlign":"left","minWidth":"100px"}
    ),

    map_component,
    pie_component
], style={"padding":"12px"})

@app.callback(
    [Output("aac-table","data"), Output("result-count","children")],
    Input("rescue-filter","value")
)
def update_table(selected):
    q = build_query(selected)
    try:
        recs = list(aac.read(q)) if q else list(aac.read({}))
    except TypeError:
        recs = list(aac.read()) if not q else list(aac.read(q))
    for r in recs:
        r.pop("_id", None)
    msg = f"{len(recs)} records" if selected != "reset" else f"All records: {len(recs)}"
    return recs, msg

@app.callback(
    [Output("map-cluster","children"), Output("breed-pie","figure")],
    Input("rescue-filter","value")
)
def update_charts(selected):
    q = build_query(selected)
    try:
        recs = list(aac.read(q)) if q else list(aac.read({}))
    except TypeError:
        recs = list(aac.read()) if not q else list(aac.read(q))

    dff = pd.DataFrame(recs)
    if dff.empty:
        return [], px.scatter(title="No data for this filter")

    # Map markers
    if {"location_lat","location_long"}.issubset(dff.columns):
        dcoords = dff.dropna(subset=["location_lat","location_long"]).head(1000)
    else:
        dcoords = pd.DataFrame(columns=["location_lat","location_long"])
    markers = [
        dl.Marker(position=[row["location_lat"], row["location_long"]],
                  children=dl.Tooltip(f"{row.get('animal_type','?')} • {row.get('breed','Unknown')}"))
        for _, row in dcoords.iterrows()
    ]

    # Pie chart
    dff["breed"] = dff["breed"].fillna("Unknown")
    top = dff["breed"].value_counts().head(10)
    other = len(dff) - int(top.sum())
    pie_df = top.reset_index()
    pie_df.columns = ["Breed","Count"]
    if other > 0:
        pie_df.loc[len(pie_df)] = ["Other", other]
    fig = px.pie(pie_df, names="Breed", values="Count", hole=0.35)
    fig.update_traces(textinfo="percent+label")
    fig.update_layout(margin=dict(l=0,r=0,t=30,b=0))

    return markers, fig

app.run_server(mode="inline", debug=False)
